.tarot-card {
  position: relative;
  width: 100%;
  aspect-ratio: 7 / 12; /* 真实塔罗牌比 */
  border-radius: 12rpx;
}

/* ===== 牌背：深靛底 + 同心细线圆环 + 中心 ✦ + 星点 ===== */
.card-back {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 12rpx;
  border: 1px solid rgba(232, 196, 124, 0.18);
  background:
    repeating-radial-gradient(circle at 50% 50%,
      rgba(232, 196, 124, 0) 0rpx, rgba(232, 196, 124, 0) 34rpx,
      rgba(232, 196, 124, 0.28) 34rpx, rgba(232, 196, 124, 0.28) 35.5rpx,
      rgba(232, 196, 124, 0) 35.5rpx, rgba(232, 196, 124, 0) 56rpx),
    linear-gradient(160deg, #0B1030 0%, #141B42 55%, #1B1B46 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.back-star {
  color: #E8C47C;
  font-size: 30rpx;
}
.back-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: rgba(232, 230, 240, 0.5);
}

/* ===== 牌面 ===== */
.face-inner {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  border-radius: 12rpx;
  border: 1px solid rgba(232, 196, 124, 0.18);
  background: rgba(35, 32, 72, 0.55);
  padding: 8% 6%;
  text-align: center;
}
.face-inner.reversed {
  transform: rotateZ(180deg); /* 逆位：牌名倒置 */
}
/* 顶部角标：组名一行 + 编号一行（· 点缀），竖向居中堆叠 */
.face-top {
  font-family: var(--font-mono);
  color: var(--ink-dim2);
  white-space: nowrap; /* 双保险：单行内部也绝不折断 */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  line-height: 1.2;
}
.ft-group {
  font-size: 22rpx;
  letter-spacing: 0.1em;
}
.ft-num {
  font-size: 18rpx;
  letter-spacing: 0.08em;
}
.ft-num::before,
.ft-num::after {
  content: '·';
  margin: 0 8rpx;
  color: rgba(139, 135, 176, 0.6);
}
.face-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.suit-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1px solid rgba(232, 196, 124, 0.55);
  border-radius: 50%;
  font-family: var(--font-display);
  color: var(--gold);
  font-size: 28rpx;
}
.suit-seal.major {
  letter-spacing: 0.04em;
}
.face-name {
  font-family: var(--font-display);
  color: var(--ink);
  letter-spacing: 0.12em;
}
.face-en {
  font-family: var(--font-display);
  font-style: italic;
  color: var(--ink-dim2);
  white-space: nowrap; /* 英文牌名独立一行，绝不折断单词 */
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.face-bottom {
  width: 60%;
  height: 1px;
  background: rgba(139, 135, 176, 0.25);
}

/* 正/逆位角签（不随牌面旋转） */
.ori-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 0.1em;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 1px solid currentColor;
  background: rgba(7, 11, 30, 0.85);
}
.ori-tag.upright { color: var(--jade); }
.ori-tag.reversed { color: var(--cinnabar); }

/* ===== 尺寸变体 ===== */
.sz-lg .face-name { font-size: 44rpx; }
.sz-lg .face-en { font-size: 28rpx; }
.sz-lg .suit-seal { font-size: 36rpx; width: 84rpx; height: 84rpx; }

.sz-md .face-name { font-size: 34rpx; }
.sz-md .face-en { font-size: 24rpx; }

.sz-sm .face-name { font-size: 24rpx; letter-spacing: 0.06em; }
.sz-sm .face-en { display: none; } /* 小卡（凯尔特十字/六芒星/牌库）空间紧张，只显中文名 */
.sz-sm .suit-seal { font-size: 22rpx; width: 48rpx; height: 48rpx; }
.sz-sm .face-inner { padding: 8% 4%; } /* 侧 padding 6%→4%，给顶部标签让位 */
/* 角标分级：md 略缩、sm 再缩（最长组名 PENTACLES 9 字符均有 ≥6% 余量） */
.sz-md .ft-group { font-size: 18rpx; letter-spacing: 0.08em; }
.sz-md .ft-num { font-size: 15rpx; }
.sz-md .ft-num::before, .sz-md .ft-num::after { margin: 0 6rpx; }
.sz-sm .ft-group { font-size: 16rpx; letter-spacing: 0.05em; }
.sz-sm .ft-num { font-size: 14rpx; }
.sz-sm .ft-num::before, .sz-sm .ft-num::after { margin: 0 4rpx; }
.sz-sm .ori-tag { display: none; } /* 牌库小图不显示角签 */

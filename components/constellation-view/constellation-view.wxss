.constellation {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}
.const-star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #E8C47C;
  transform: translate(-50%, -50%);
}
.const-edge {
  position: absolute;
  height: 2rpx;
  transform-origin: 0 50%;
  margin-top: -1rpx; /* 细条垂直中心对齐星点 */
}
.const-edge-fill {
  width: 100%;
  height: 100%;
  background: rgba(232, 196, 124, 0.55);
}

/* dim 色调：星轨仪非选中星座（暗蓝灰） */
.constellation.dim .const-star {
  background: #6B7194;
}
.constellation.dim .const-edge-fill {
  background: rgba(107, 113, 148, 0.5);
}

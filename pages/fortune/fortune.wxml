<!-- 星运页 -->
<view class="page">
  <star-layer />

  <!-- 页眉：眉题 + 词标 + 日期 + ✦ 饰线 -->
  <view class="header">
    <view class="eyebrow">EPHEMERIS · 星历</view>
    <view class="wordmark">
      <text class="wm-zh">星语</text>
      <text class="wm-en">StarWhisper</text>
    </view>
    <view class="today mono">{{todayText}}</view>
  </view>
  <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>

  <!-- 登录引导条：未登录常驻（弹窗只出现一次，这个一直在，可随时去登录） -->
  <view wx:if="{{!loggedIn}}" class="login-banner" bindtap="goLogin">
    <text class="lb-star">✦</text>
    <text class="lb-text">登录后可同步抽牌、起卦与打卡记录</text>
    <text class="lb-go mono">去登录 ›</text>
  </view>

  <!-- 断连错误态（不白屏） -->
  <view wx:if="{{error}}" class="glass-card state-box">
    <view class="state-icon">✧</view>
    <view class="state-text">{{error}}</view>
    <button size="mini" class="btn-gold" bindtap="retry">重新连接</button>
  </view>

  <block wx:else>
    <!-- 星盘：12 圆形底座节点骑双环轨道，点击旋转把选中星座转到正上方 -->
    <view class="wheel-wrap">
      <view class="wheel {{animated ? 'animated' : ''}}" style="transform:rotate({{ringAngle}}deg)">
        <!-- 双环轨道（清晰可见） + 60 格刻度（天文钟精密感） -->
        <view class="orbit-ring outer"></view>
        <view class="orbit-ring inner"></view>
        <!-- 星座节点：圆形底座 + 符号 + 名字；反向旋转保持正向可读 -->
        <view
          wx:for="{{signs}}"
          wx:key="id"
          class="sign-node {{item.id === currentSignId ? 'active' : ''}}"
          style="{{nodeStyles[index]}}"
          data-id="{{item.id}}"
          bindtap="onSignTap"
          hover-class="node-pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="{{item.name + (item.id === currentSignId ? '，当前选中' : '，查看今日运势')}}"
        >
          <view class="node-inner" style="transform:rotate({{-ringAngle}}deg)">
            <text wx:if="{{item.id === currentSignId}}" class="selected-mark" aria-hidden="true">✓</text>
            <view class="node-const"><constellation-view sign="{{item.nameEn}}" /></view>
            <view class="node-name">{{item.name}}</view>
          </view>
        </view>
      </view>
      <!-- 中心信息：衬线中文名 + 英文斜体 + 日期范围，不随环转 -->
      <view class="wheel-center">
        <view class="center-label">当前星座</view>
        <view wx:if="{{currentSign}}" class="center-const"><constellation-view sign="{{currentSign.nameEn}}" /></view>
        <view class="center-name">{{currentSign ? currentSign.name : ''}}</view>
        <view class="center-en">{{currentSign ? currentSign.nameEn : ''}}</view>
        <view class="center-range mono">{{currentSign ? currentSign.dateRange : ''}}</view>
      </view>
    </view>
    <view class="wheel-hint">点击星座，查看{{mode === 'week' ? '本周' : '今日'}}运势</view>

    <!-- 今日/本周切换（与塔罗牌阵同款的 mode-btn 风格） -->
    <view class="mode-row scope-tabs">
      <view
        class="mode-btn mono {{mode === 'today' ? 'active' : ''}}"
        data-mode="today"
        bindtap="onModeTap"
        hover-class="node-pressed"
        aria-role="button"
        aria-label="查看今日运势"
      >今日 · TODAY</view>
      <view
        class="mode-btn mono {{mode === 'week' ? 'active' : ''}}"
        data-mode="week"
        bindtap="onModeTap"
        hover-class="node-pressed"
        aria-role="button"
        aria-label="查看本周运势"
      >本周 · WEEK</view>
    </view>

    <!-- ===== 本周视图（view + hidden：保住今日视图的 canvas 不被销毁；block 不认 hidden） ===== -->
    <view hidden="{{mode !== 'week'}}">
      <!-- 周运加载态 -->
      <view wx:if="{{weeklyLoading && !weekly}}" class="glass-card state-box">
        <view class="spinner"></view>
        <view class="state-text">正在聆听本周星象…</view>
      </view>

      <!-- 周运错误态：无本地兜底，失败就明说，不显示旧数据 -->
      <view wx:elif="{{weeklyError}}" class="glass-card state-box">
        <view class="state-icon">✧</view>
        <view class="state-text">{{weeklyError}}</view>
        <button size="mini" class="btn-gold" bindtap="retryWeekly">重试</button>
      </view>

      <!-- 周运卡（刷新时保留旧内容，仅变淡） -->
      <view wx:elif="{{weekly}}" class="content {{weeklyLoading ? 'refreshing' : ''}}">
        <view class="glass-card fortune-card">
          <view class="fc-head">
            <view class="fc-name">
              <text class="zh">{{weekly.signName}}</text>
              <text class="en">{{weekly.signNameEn}}</text>
            </view>
            <view class="fc-meta mono">
              <text class="meta-seg">本周运势</text>
              <text wx:if="{{weeklyView.rangeText}}" class="meta-seg"> · {{weeklyView.rangeText}}</text>
            </view>
          </view>

          <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>

          <!-- 四维评分进度条（复用星图读数的 r-bar 样式；null 维度整行隐藏） -->
          <view class="readout weekly-readout">
            <view wx:for="{{weeklyView.dimensions}}" wx:key="en" class="readout-item">
              <view class="r-label">
                <text class="r-zh">{{item.zh}}</text>
                <text class="r-en mono">{{item.en}}</text>
              </view>
              <view class="r-bar"><view class="r-bar-fill" style="width:{{item.score / 5 * 100}}%"></view></view>
              <text class="r-val mono">{{item.score}}/5</text>
            </view>
          </view>

          <!-- 本周提醒 -->
          <view wx:if="{{weekly.weekNotice}}" class="notice">
            <text class="notice-chip mono">本周提醒</text>
            <text class="notice-text">{{weekly.weekNotice}}</text>
          </view>

          <!-- 幸运信息行：幸运色/幸运数字/幸运日/贵人/小人（null 项不显示） -->
          <view class="lucky-row weekly-lucky">
            <view wx:for="{{weeklyView.luckyItems}}" wx:key="key" class="lucky-item">
              <view class="lucky-label mono">{{item.label}}</view>
              <view class="lucky-value {{item.key === 'number' ? 'number mono' : ''}}">
                <view wx:if="{{item.key === 'color'}}" class="color-chip" style="background:{{weeklyView.luckyColorBg}}"></view>
                {{item.value}}
              </view>
            </view>
          </view>

          <!-- 四段文案：综合/爱情/事业/财富（null 段不显示） -->
          <block wx:if="{{weeklyView.insights.length}}">
            <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>
            <view class="insights">
              <view wx:for="{{weeklyView.insights}}" wx:key="en" class="insight">
                <view class="i-label">
                  <text class="i-zh">{{item.zh}}</text>
                  <text class="i-en mono">{{item.en}}</text>
                </view>
                <view class="i-text">{{item.txt}}</view>
              </view>
            </view>
          </block>

          <!-- 来源签：周运只会是 SHOWAPI（无本地兜底） -->
          <view class="fc-footer weekly-footer">
            <text class="source-tag mono {{weekly.source === 'SHOWAPI' ? 'showapi' : ''}}">
              {{weekly.source === 'SHOWAPI' ? 'DATA · 万维易源 SHOWAPI' : 'DATA · 本地星算 LOCAL'}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 今日视图（view + hidden：ec-canvas 常驻，来回切换 tab 图表不丢） ===== -->
    <view hidden="{{mode !== 'today'}}">
    <!-- 首次加载态 -->
    <view wx:if="{{loading && !fortune}}" class="glass-card state-box">
      <view class="spinner"></view>
      <view class="state-text">正在聆听星辰的低语…</view>
    </view>

    <!-- 主内容（刷新时保留旧内容，仅变淡） -->
    <view wx:if="{{fortune}}" class="content {{loading ? 'refreshing' : ''}}">
      <!-- ===== 今日运势卡 ===== -->
      <view class="glass-card fortune-card">
        <view class="fc-head">
          <view class="fc-name">
            <text class="zh">{{fortune.signName}}</text>
            <text class="en">{{fortune.signNameEn}}</text>
          </view>
          <view class="fc-meta mono">
            <text wx:for="{{view.metaParts}}" wx:key="index" class="meta-seg">{{item}}{{index < view.metaParts.length - 1 ? ' · ' : ''}}</text>
          </view>
        </view>

        <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>

        <!-- 评分（healthScore 为 null 时健康行自动隐藏） -->
        <view class="score-list">
          <view wx:for="{{view.dimensions}}" wx:key="en" class="score-row">
            <view class="dim-label">
              <text class="dim-zh">{{item.zh}}</text>
              <text class="dim-en mono">{{item.en}}</text>
            </view>
            <view class="glyphs">
              <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="n" wx:key="n" class="{{n <= item.score ? 'on' : 'off'}}">✦</text>
            </view>
          </view>
        </view>

        <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>

        <!-- 幸运条目 -->
        <view class="lucky-row">
          <view class="lucky-item">
            <view class="lucky-label mono">LUCKY COLOR · 幸运色</view>
            <view class="lucky-value">
              <view class="color-chip" style="background:{{view.luckyColorBg}}"></view>
              {{fortune.luckyColor}}
            </view>
          </view>
          <view class="lucky-item">
            <view class="lucky-label mono">NUMBER · 幸运数字</view>
            <view class="lucky-value number mono">{{fortune.luckyNumber}}</view>
          </view>
          <view class="lucky-item">
            <view class="lucky-label mono">HOUR · 吉时</view>
            <view class="lucky-value mono">{{fortune.luckyTime}}</view>
          </view>
          <view wx:if="{{fortune.luckyDirection}}" class="lucky-item">
            <view class="lucky-label mono">DIRECTION · 方位</view>
            <view class="lucky-value">{{fortune.luckyDirection}}</view>
          </view>
        </view>

        <!-- 点评引文 -->
        <view class="summary">{{fortune.summary}}</view>

        <!-- 今日提醒 -->
        <view wx:if="{{fortune.dayNotice}}" class="notice">
          <text class="notice-chip mono">提醒</text>
          <text class="notice-text">{{fortune.dayNotice}}</text>
        </view>

        <!-- 速配/贵人（pairSignName 为 null 时整块隐藏） -->
        <view wx:if="{{fortune.pairSignName}}" class="seal-row">
          <view class="pair-box">
            <view class="pair-label mono">MATCH · {{view.pairLabel}}</view>
            <view class="pair-const"><constellation-view sign="{{fortune.pairSignName}}" /></view>
            <view class="pair-name">{{fortune.pairSignName}}</view>
          </view>
        </view>

        <!-- 分维解读 -->
        <block wx:if="{{view.insights.length}}">
          <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>
          <view class="insights">
            <view wx:for="{{view.insights}}" wx:key="en" class="insight">
              <view class="i-label">
                <text class="i-zh">{{item.zh}}</text>
                <text class="i-en mono">{{item.en}}</text>
              </view>
              <view class="i-text">{{item.txt}}</view>
            </view>
          </view>
        </block>

        <!-- 来源签 + 分享卡 -->
        <view class="fc-footer">
          <view class="share-btn mono" bindtap="onShareTap">✦ 分享卡</view>
          <text class="source-tag mono {{view.isShowapi ? 'showapi' : ''}}">{{view.sourceTag}}</text>
        </view>
      </view>

      <!-- ===== 五维/四象星图 ===== -->
      <view class="glass-card chart-card">
        <view class="chart-title">
          {{fortune.healthScore != null ? '五维星图' : '四象星图'}}
          <text class="chart-title-en mono">{{fortune.healthScore != null ? 'PENTAGRAM' : 'QUADGRAM'}}</text>
        </view>
        <ec-canvas id="radar-canvas" class="chart-canvas" canvas-id="radar" echarts="{{echarts}}" ec="{{radarEc}}"></ec-canvas>

        <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>
        <view class="readout">
          <view wx:for="{{view.dimensions}}" wx:key="en" class="readout-item">
            <view class="r-label">
              <text class="r-zh">{{item.zh}}</text>
              <text class="r-en mono">{{item.en}}</text>
            </view>
            <view class="r-bar"><view class="r-bar-fill" style="width:{{item.score / 5 * 100}}%"></view></view>
            <text class="r-val mono">{{item.score}}/5</text>
          </view>
        </view>

        <view wx:if="{{fortune.healthTxt}}" class="health-quote">{{fortune.healthTxt}}</view>

        <view wx:if="{{view.profile || view.element}}" class="profile mono">
          <text wx:if="{{view.element}}" class="p-item"><text class="p-key">元素</text>{{view.element}}</text>
          <text wx:if="{{view.profile}}" class="p-item"><text class="p-key">守护星</text>{{view.profile.planet}}</text>
          <text wx:if="{{view.profile}}" class="p-item"><text class="p-key">幸运石</text>{{view.profile.gem}}</text>
        </view>
      </view>

      <!-- ===== 近 7 天趋势 ===== -->
      <view class="glass-card chart-card">
        <view class="chart-title">近 7 天运势趋势 <text class="chart-title-en mono">7-DAY TREND</text></view>
        <ec-canvas id="trend-canvas" class="chart-canvas tall" canvas-id="trend" echarts="{{echarts}}" ec="{{trendEc}}"></ec-canvas>
      </view>
    </view>
    </view>
  </block>

  <view class="footer mono">
    <view class="f-legal">星语 STARWHISPER · 仅供娱乐</view>
    <view class="f-wish"><text class="f-star">✦</text> 愿你被星辰温柔以待 <text class="f-star">✦</text></view>
  </view>

  <!-- 分享海报：离屏 canvas（隐藏节点，仅用于绘制导出） -->
  <canvas type="2d" id="poster-canvas" class="poster-canvas"></canvas>

  <!-- 海报预览弹层 -->
  <view wx:if="{{posterImage}}" class="poster-mask" bindtap="closePoster">
    <view class="poster-modal" catchtap="noop">
      <image class="poster-img" src="{{posterImage}}" mode="widthFix" show-menu-by-longpress />
      <view class="poster-actions">
        <button size="mini" class="btn-gold" bindtap="savePoster">保存到相册</button>
        <view class="poster-close mono" bindtap="closePoster">关闭</view>
      </view>
    </view>
  </view>
</view>

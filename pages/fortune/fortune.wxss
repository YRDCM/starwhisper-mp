/* ===== 星运页样式（rpx，字号地板 ≥24rpx 对齐 Web fontfix） ===== */

/* 页面级横向溢出兜底：星盘满屏出血 + 选中光晕的阴影墨溢出会把页面撑宽 */
page {
  overflow-x: hidden;
}

.page {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx 64rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ===== 页眉 ===== */
.header {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 6rpx;
}
.wordmark {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.wm-zh {
  font-family: var(--font-display);
  font-size: 64rpx;
  letter-spacing: 0.22em;
  color: var(--gold);
}
.wm-en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 36rpx;
  color: var(--ink-dim2);
}
.today {
  font-size: 26rpx;
  letter-spacing: 0.14em;
  color: var(--ink-dim2);
}

/* ===== 星盘（旧版底座风 · 加大圆隙） ===== */
.wheel-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  /* 满屏出血：抵消 page 左右 24rpx padding，轮盘 750rpx 撑满屏宽 */
  margin: 0 -24rpx;
  /* 选中底座 box-shadow 光晕（32rpx）超出屏宽会撑出横向滚动条，裁在容器内 */
  overflow: hidden;
  padding: 40rpx 0 48rpx;
}
.wheel {
  position: relative;
  flex: none; /* 轮盘 750×750 刚性正方形，不允许 flex 拉伸/收缩 */
  width: 750rpx;
  height: 750rpx;
}
.wheel.animated {
  transition: transform 0.6s ease-out; /* 旋转星环：选中转到正上方 */
}
/* 轨道双环：显式 rpx 正方形尺寸 + 居中（与节点 rotate/translate 共用 750rpx 正方形几何基准）。
   不用四向内缩/百分比充满——任何包含块解析差异都不会把环拉成椭圆；
   1px 实体像素描边（1rpx 在真机高分屏会被圆整吃掉） */
.orbit-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
}
.orbit-ring.outer {
  width: 738rpx;
  height: 738rpx;
  border: 1px solid rgba(232, 201, 122, 0.22);
}
.orbit-ring.inner {
  width: 530rpx;
  height: 530rpx;
  border: 1px solid rgba(139, 135, 176, 0.14);
}
/* 中心三行：不随环转；pointer-events 放行，避免挡节点点击 */
.wheel-center {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  transform: translate(-50%, -50%);
  width: 340rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  pointer-events: none;
}
.center-name {
  font-family: var(--font-display);
  font-size: 64rpx;
  color: var(--gold);
  letter-spacing: 0.2em;
  text-indent: 0.2em; /* letter-spacing 末位补偿，视觉居中 */
}
.center-en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 28rpx;
  color: var(--ink-dim2);
}
.center-range {
  font-size: 23rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}

/* 星座节点：圆形底座 + 符号 + 名字；Ø120、轨道半径 305 → 节点外缘 365，
   距屏边（375）留 10rpx 呼吸；相邻圆心弦距约 158 → 圆间净隙约 38rpx */
.sign-node {
  position: absolute;
  left: 50%;
  top: 50%;
  margin: -60rpx 0 0 -60rpx;
  width: 120rpx;
  height: 120rpx;
}
.node-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 1px solid rgba(139, 135, 176, 0.22);
  background: rgba(35, 32, 72, 0.5);
  transition: transform 0.6s ease-out, border-color 0.25s, box-shadow 0.25s, background 0.25s;
}
.wheel:not(.animated) .node-inner {
  transition: none;
}
/* 选中：金色高亮底座（旧版选中态） */
.sign-node.active .node-inner {
  border-color: var(--gold);
  background: rgba(232, 196, 124, 0.10);
  box-shadow: 0 0 32rpx rgba(232, 196, 124, 0.4), inset 0 0 20rpx rgba(232, 196, 124, 0.14);
}
.node-const {
  width: 44rpx;
  height: 44rpx;
}
.node-name {
  font-family: var(--font-display);
  font-size: 24rpx;
  letter-spacing: 0.08em;
  white-space: nowrap;
  color: var(--ink);
}
.sign-node.active .node-name {
  color: var(--gold);
}

/* ===== 主内容 ===== */
.content {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  transition: opacity 0.25s ease;
}
.content.refreshing {
  opacity: 0.55;
  pointer-events: none;
}

/* ===== 运势卡 ===== */
.fortune-card {
  padding: 40rpx 36rpx 32rpx;
}
.fc-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.fc-name .zh {
  font-family: var(--font-display);
  font-size: 56rpx;
  color: var(--gold);
  letter-spacing: 0.14em;
}
.fc-name .en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 32rpx;
  color: var(--ink-dim2);
  margin-left: 20rpx;
}
.fc-meta {
  font-size: 26rpx;
  letter-spacing: 0.12em;
  color: var(--ink-dim2);
}
.meta-seg {
  /* 每段不折断，只在 · 分隔处换行 */
  display: inline-block;
}

/* 评分 */
.score-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.score-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.dim-label {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.dim-zh {
  font-size: 30rpx;
  letter-spacing: 0.16em;
  color: var(--ink);
  white-space: nowrap; /* 维度中文名（如综合运势）不折断 */
}
.dim-en {
  font-size: 25rpx;
  letter-spacing: 0.14em;
  color: var(--ink-dim2);
  white-space: nowrap;
}
.glyphs {
  letter-spacing: 0.24em;
  font-size: 28rpx;
}
.glyphs .on {
  color: var(--gold);
}
.glyphs .off {
  color: rgba(139, 135, 176, 0.35);
}

/* 幸运条目 */
.lucky-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 56rpx;
}
.lucky-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.lucky-label {
  font-size: 25rpx;
  letter-spacing: 0.14em;
  color: var(--ink-dim2);
}
.lucky-value {
  font-size: 30rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.lucky-value.number {
  font-size: 38rpx;
  color: var(--gold);
}
.color-chip {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 1px solid rgba(232, 230, 240, 0.4);
}

/* 点评引文 */
.summary {
  margin: 32rpx 0 24rpx;
  padding: 8rpx 0 8rpx 28rpx;
  border-left: 4rpx solid var(--gold);
  font-family: var(--font-display);
  font-size: 32rpx;
  line-height: 2;
  color: var(--ink);
}

/* 今日提醒横幅 */
.notice {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin: 0 0 28rpx;
  padding: 14rpx 22rpx;
  border: 1px solid rgba(139, 135, 176, 0.16);
  border-radius: 8rpx;
}
.notice-chip {
  flex: none;
  font-size: 25rpx;
  letter-spacing: 0.16em;
  color: var(--gold);
  border: 1px solid var(--gold-hairline);
  border-radius: 6rpx;
  padding: 2rpx 14rpx;
}
.notice-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-dim2);
}

/* 速配/贵人（宜/忌已随后端去伪改造移除） */
.seal-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.pair-box {
  flex: none;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 24rpx;
  border: 1px solid rgba(139, 135, 176, 0.16);
  border-radius: 8rpx;
}
.pair-label {
  font-size: 24rpx;
  letter-spacing: 0.16em;
  color: var(--ink-dim2);
}
.pair-const {
  width: 52rpx;
  height: 52rpx;
}
.pair-name {
  font-family: var(--font-display);
  font-size: 28rpx;
  letter-spacing: 0.12em;
  color: var(--ink);
}

/* 分维解读 */
.insights {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.i-label {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.i-zh {
  font-size: 30rpx;
  letter-spacing: 0.18em;
  color: var(--gold);
}
.i-en {
  font-size: 25rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}
.i-text {
  font-size: 30rpx;
  line-height: 2;
  color: rgba(232, 230, 240, 0.9);
}

/* 来源签 */
.fc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
}
.share-btn {
  flex: none;
  white-space: nowrap; /* 「✦ 分享卡」符号与文字同行 */
  font-size: 25rpx;
  letter-spacing: 0.14em;
  color: var(--gold);
  border: 1px solid var(--gold-hairline);
  border-radius: 6rpx;
  padding: 8rpx 22rpx;
}
.source-tag {
  flex: none;
  white-space: nowrap; /* 「DATA · 万维易源 SHOWAPI」不折断 */
  font-size: 25rpx;
  letter-spacing: 0.16em;
  color: var(--ink-dim2);
}
.source-tag.showapi {
  color: var(--gold);
}

/* ===== 图表卡 ===== */
.chart-card {
  padding: 36rpx 32rpx;
}
.chart-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  letter-spacing: 0.24em;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.chart-title-en {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  margin-left: 16rpx;
  white-space: nowrap; /* 英文短语不在空格/连字符处断成两截 */
}
.chart-canvas {
  width: 100%;
  height: 520rpx;
  display: block;
}
.chart-canvas.tall {
  height: 460rpx;
}

/* 读数条 */
.readout {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.readout-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.r-label {
  /* 定宽对齐：各行进度条起点一致；264rpx ≥ 最长内容「综合运势 OVERALL」约 258rpx */
  flex: 0 0 264rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  white-space: nowrap; /* 保留防折行：中文+英文一行放下 */
}
.r-zh {
  font-size: 28rpx;
  letter-spacing: 0.14em;
  color: var(--ink);
  white-space: nowrap;
}
.r-en {
  font-size: 24rpx;
  letter-spacing: 0.1em;
  color: var(--ink-dim2);
  white-space: nowrap;
}
.r-bar {
  flex: 1;
  height: 4rpx;
  background: rgba(139, 135, 176, 0.15);
  border-radius: 2rpx;
  overflow: hidden;
}
.r-bar-fill {
  display: block;
  height: 100%;
  background: var(--gold);
  border-radius: 2rpx;
  transition: width 0.5s ease;
}
.r-val {
  flex: none;
  width: 76rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--gold);
}

/* 健康寄语 */
.health-quote {
  margin: 0 0 32rpx;
  padding: 8rpx 0 8rpx 28rpx;
  border-left: 4rpx solid var(--gold);
  font-family: var(--font-display);
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
}

/* 星座档案 */
.profile {
  padding-top: 24rpx;
  border-top: 1px solid rgba(139, 135, 176, 0.16);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 40rpx;
  font-size: 26rpx;
  letter-spacing: 0.1em;
  color: var(--ink);
}
.p-item {
  /* 单个档案项内部不折断，项与项之间由 .profile 的 flex-wrap 换行 */
  white-space: nowrap;
}
.p-key {
  color: var(--ink-dim2);
  margin-right: 12rpx;
}

/* 状态图标 */
.state-icon {
  font-size: 60rpx;
  color: var(--gold);
}

/* 页脚 */
.footer {
  margin-top: auto;
  padding-top: 72rpx;
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}
/* 寄语行：视觉收尾，展示字体 + 香槟金 + ✦ 点缀 */
.f-wish {
  margin-top: 12rpx;
  font-family: var(--font-display);
  font-size: 26rpx;
  letter-spacing: 0.3em;
  color: var(--gold);
}
.f-wish .f-star {
  font-size: 20rpx;
  color: rgba(232, 196, 124, 0.55);
}

/* ===== 分享海报 ===== */
/* 离屏画布：移出视口左侧（主流海报方案；canvas 绘制缓冲与位置无关）。
   绝不能放进视口——canvas 是原生组件，同层渲染退化时 opacity/z-index/
   pointer-events 全部失效，会隐形盖住首屏拦截触摸导致页面划不动 */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750rpx;
  height: 1200rpx;
}
.poster-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 50;
  background: rgba(7, 11, 30, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.poster-modal {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.poster-img {
  width: 560rpx;
  border-radius: 12rpx;
  border: 1px solid var(--gold-hairline);
}
.poster-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}
.poster-close {
  font-size: 26rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  padding: 8rpx 24rpx;
}

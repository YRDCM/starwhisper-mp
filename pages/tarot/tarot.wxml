<!-- 塔罗页 -->

<!-- 大牌阵通用小牌格（sm）：牌位标签 + 3D 翻牌；spreadCard 无标签版供中心叠放格复用 -->
<template name="spreadCard">
  <view class="flip sm {{revealedCount > cell.orderIndex ? 'flipped' : ''}} {{revealedCount === cell.orderIndex ? 'can-reveal' : ''}}" data-index="{{cell.orderIndex}}" bindtap="onRevealCard">
      <view class="flip-inner">
      <view class="flip-back"><tarot-card faceDown size="sm" /></view>
      <view class="flip-front"><tarot-card wx:if="{{revealedCount > cell.orderIndex}}" card="{{cell.card}}" orientation="{{cell.orientation}}" size="sm" /></view>
    </view>
  </view>
</template>
<template name="spreadCell">
  <view class="pos mono">{{cell.position}}</view>
  <template is="spreadCard" data="{{cell, revealedCount}}" />
</template>

<view class="page">
  <star-layer />

  <view class="eyebrow">TAROT · 塔罗</view>
  <view class="wordmark">
    <text class="wm-zh">塔罗</text>
    <text class="wm-en">Tarot</text>
  </view>
  <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>

  <!-- ===== 每日塔罗（自动加载） ===== -->
  <view class="glass-card daily {{dailyLoading && daily ? 'refreshing' : ''}}">
    <view wx:if="{{dailyError}}" class="state-box">
      <view class="state-text">{{dailyError}}</view>
      <button class="btn-gold" bindtap="loadDaily">重新连接</button>
    </view>
    <view wx:elif="{{dailyLoading && !daily}}" class="state-box">
      <view class="spinner"></view>
      <view class="state-text">正在洗牌…</view>
    </view>
    <block wx:elif="{{daily}}">
      <view class="daily-face">
        <tarot-card card="{{daily.card}}" orientation="{{daily.orientation}}" size="lg" />
      </view>
      <view class="daily-panel">
        <view class="eyebrow">DAILY TAROT · {{todayStr}}</view>
        <view class="daily-name">
          <text class="zh">{{daily.card.name}}</text>
          <text class="en">{{daily.card.nameEn}}</text>
        </view>
        <view>
          <view class="stamp {{daily.orientation === 'reversed' ? 'cinnabar' : 'jade'}}">
            {{daily.orientation === 'reversed' ? '逆位' : '正位'}}
          </view>
        </view>
        <view class="kw-chips">
          <text wx:for="{{dailyKeywords}}" wx:key="index" class="kw-chip">{{item}}</text>
        </view>
        <view class="meaning">{{daily.meaning}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{daily.card}}" class="glass-card lesson">
    <view class="eyebrow">DAILY STUDY · 今日识牌</view>
    <view class="sec-title">认识 {{daily.card.name}}</view>
    <view class="spread-hint">从今天的牌开始，先观察画面，再对照正逆位含义。</view>
    <button class="btn-gold" bindtap="toggleLesson">{{lessonOpen ? '收起知识' : '学习这张牌'}}</button>
    <view wx:if="{{lessonOpen}}" class="lesson-body">
      <view class="m-label">正位 · {{daily.card.uprightKeywords}}</view>
      <view class="m-text">{{daily.card.uprightMeaning}}</view>
      <view class="m-label">逆位 · {{daily.card.reversedKeywords}}</view>
      <view class="m-text">{{daily.card.reversedMeaning}}</view>
      <view class="spread-hint">想一想：这张牌的哪个关键词，让你联想到最近的一件小事？</view>
      <button class="btn-gold" disabled="{{todayLearned}}" bindtap="markLearned">{{todayLearned ? '这张牌已学习 ✓' : '标记已学习'}}</button>
    </view>
    <view class="spread-hint">已学习 {{learnedCards.length}} / 78 张 · 仅保存在当前设备</view>
    <view wx:if="{{studyError}}" class="error-line">{{studyError}}</view>
  </view>

  <!-- ===== 抽牌仪式 ===== -->
  <view class="glass-card ritual">
    <view class="sec-title">抽牌仪式 <text class="sec-title-en mono">RITUAL</text></view>

    <!-- 牌阵选择：日常 / 进阶两组，按钮标注牌数 -->
    <view class="mode-group" wx:for="{{spreadGroups}}" wx:key="label">
      <view class="mode-group-label mono">{{item.label}}</view>
      <view class="mode-row">
        <view
          wx:for="{{item.items}}"
          wx:for-item="s"
          wx:key="key"
          class="mode-btn mono {{mode === s.key ? 'active' : ''}} {{drawing ? 'disabled' : ''}}"
          data-mode="{{s.key}}"
          bindtap="setMode"
        >
          <text>{{s.name}}</text>
          <text class="mode-count">{{s.count}} 张</text>
        </view>
      </view>
    </view>

    <view class="spread-hint">{{spreadHints[mode]}}</view>
    <view wx:if="{{drawError}}" class="error-line">{{drawError}}</view>

    <!-- 抽牌前：牌背排 + 开始抽牌（进入选牌界面） -->
    <block wx:if="{{!drawn.length}}">
      <block wx:if="{{!picking}}">
        <view class="backs-row">
          <view wx:for="{{backCount}}" wx:key="index" class="back-item">
            <tarot-card faceDown size="md" />
          </view>
        </view>
        <view class="stage-actions">
          <button class="btn-gold {{drawing ? 'disabled' : ''}}" bindtap="startPick" disabled="{{drawing}}">
            {{drawing ? '洗牌抽牌中…' : '开始抽牌'}}
          </button>
        </view>
      </block>

      <!-- 选牌界面：78 张洗牌后的牌背铺满 6 列网格，点位置选牌（对应洗好的牌序号） -->
      <block wx:else>
        <view class="pick-head">
          <view class="pick-title">以心选牌 <text class="pick-title-en mono">CHOOSE YOUR CARDS</text></view>
          <view class="pick-progress mono">已选 {{pickedCount}} / {{needCount}}</view>
        </view>
        <view class="spread-hint">{{pickFull ? '已选满，可以确认开牌' : '还需选 ' + (needCount - pickedCount) + ' 张'}} · 再次点击可取消</view>
        <scroll-view scroll-y class="pick-scroll" enhanced show-scrollbar="{{false}}">
          <view class="pick-grid">
            <view
              wx:for="{{deck}}"
              wx:key="no"
              class="pick-item {{item.selected ? 'selected' : ''}}"
              data-index="{{index}}"
              bindtap="onPickCard"
            >
              <!-- 统一牌背：纯 CSS（内框几何线 + 弯月 + ✦ + 菱形 + 星点），无外部图片 -->
              <view class="pick-back">
                <view class="pb-frame"></view>
                <view class="pb-moon"></view>
                <text class="pb-star">✦</text>
                <view class="pb-diamond"></view>
              </view>
              <view wx:if="{{item.selected}}" class="pick-order mono">{{item.order}}</view>
            </view>
          </view>
        </scroll-view>
        <view class="pick-actions">
          <button
            class="btn-gold {{pickFull && !drawing ? '' : 'disabled'}}"
            bindtap="confirmPick"
            disabled="{{!pickFull || drawing}}"
          >
            {{drawing ? '洗牌开牌中…' : '确认开牌'}}
          </button>
          <view class="pick-links">
            <text class="pick-link" bindtap="randomPick">随机为我抽</text>
            <text class="pick-link dim" bindtap="cancelPick">返回</text>
          </view>
        </view>
      </block>
    </block>

    <!-- 抽牌后：3D 翻牌（逐张延迟 150ms） -->
    <block wx:else>
      <view class="reveal-guide">
        <view class="m-label">已揭晓 {{revealedCount}} / {{drawn.length}} 张</view>
        <view wx:if="{{nextCard}}" class="m-text">下一张 · {{nextCard.position || '单牌指引'}}
          <view>{{nextCard.positionDesc || '看看这张牌带来的思考方向。'}}</view>
        </view>
        <view wx:else class="m-text">全部牌面已揭晓，可以回看各牌解读。</view>
        <view wx:if="{{nextCard}}" class="reveal-actions">
          <button class="btn-gold" bindtap="revealNext">揭晓第 {{revealedCount + 1}} 张</button>
          <button class="btn-gold" bindtap="revealAll">一键全部揭晓</button>
        </view>
      </view>
      <!-- single / three：横排 -->
      <view wx:if="{{spread === 'single' || spread === 'three'}}" class="drawn-row">
        <view wx:for="{{drawn}}" wx:key="index" class="drawn-item">
          <view wx:if="{{item.position}}" class="pos mono">{{item.position}}</view>
          <view class="flip {{revealedCount > item.orderIndex ? 'flipped' : ''}} {{revealedCount === item.orderIndex ? 'can-reveal' : ''}}" data-index="{{item.orderIndex}}" bindtap="onRevealCard">
      <view class="flip-inner">
              <view class="flip-back"><tarot-card faceDown size="md" /></view>
              <view class="flip-front"><tarot-card wx:if="{{revealedCount > item.orderIndex}}" card="{{item.card}}" orientation="{{item.orientation}}" size="md" /></view>
            </view>
          </view>
        </view>
      </view>

      <!-- choice：现状居中略小（顶）+ 选择 A/B 左右两翼（分叉线装饰） -->
      <view wx:elif="{{spread === 'choice'}}" class="choice-layout">
        <view class="choice-top">
          <view class="pos mono">{{choiceTop.position}}</view>
          <view class="flip sm {{revealedCount > choiceTop.orderIndex ? 'flipped' : ''}} {{revealedCount === choiceTop.orderIndex ? 'can-reveal' : ''}}" data-index="{{choiceTop.orderIndex}}" bindtap="onRevealCard">
      <view class="flip-inner">
              <view class="flip-back"><tarot-card faceDown size="sm" /></view>
              <view class="flip-front"><tarot-card wx:if="{{revealedCount > choiceTop.orderIndex}}" card="{{choiceTop.card}}" orientation="{{choiceTop.orientation}}" size="sm" /></view>
            </view>
          </view>
        </view>
        <view class="fork">
          <view class="fork-line left"></view>
          <view class="fork-line right"></view>
        </view>
        <view class="choice-wings">
          <view wx:for="{{choiceWings}}" wx:key="index" class="drawn-item">
            <view class="pos mono">{{item.position}}</view>
            <view class="flip {{revealedCount > item.orderIndex ? 'flipped' : ''}} {{revealedCount === item.orderIndex ? 'can-reveal' : ''}}" data-index="{{item.orderIndex}}" bindtap="onRevealCard">
      <view class="flip-inner">
                <view class="flip-back"><tarot-card faceDown size="md" /></view>
                <view class="flip-front"><tarot-card wx:if="{{revealedCount > item.orderIndex}}" card="{{item.card}}" orientation="{{item.orientation}}" size="md" /></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- love：爱情十字（上=现实阻碍，左=你的状态，中=关系现状，右=对方的状态，下=结果与建议） -->
      <view wx:elif="{{spread === 'love'}}" class="love-grid">
        <view wx:for="{{[loveCells.top, loveCells.left, loveCells.center, loveCells.right, loveCells.bottom]}}"
              wx:key="index"
              class="love-cell c{{index}}">
          <block wx:if="{{item}}">
            <view class="pos mono">{{item.position}}</view>
            <view class="flip {{revealedCount > item.orderIndex ? 'flipped' : ''}} {{revealedCount === item.orderIndex ? 'can-reveal' : ''}}" data-index="{{item.orderIndex}}" bindtap="onRevealCard">
      <view class="flip-inner">
                <view class="flip-back"><tarot-card faceDown size="sm" /></view>
                <view class="flip-front"><tarot-card wx:if="{{revealedCount > item.orderIndex}}" card="{{item.card}}" orientation="{{item.orientation}}" size="sm" /></view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- 凯尔特十字（10 牌）：左十字区 3×3 + 右杖列
           十字区：row1 [空, 5 显意识目标, 空]
                   row2 [4 过去的印记, 1 现状核心 + 2 障碍与挑战横压其上, 6 未来的发展]
                   row3 [空, 3 潜意识根源, 空]
           杖列自上而下 10/9/8/7（牌阵自下而上 7→10 建起） -->
      <view wx:elif="{{spread === 'celtic'}}" class="celtic-layout">
        <view class="celtic-cross">
          <view></view>
          <view class="cc-cell"><template is="spreadCell" data="{{cell: drawn[4], revealedCount}}" /></view>
          <view></view>
          <view class="cc-cell"><template is="spreadCell" data="{{cell: drawn[3], revealedCount}}" /></view>
          <view class="cc-cell cc-center">
            <view class="pos mono">{{drawn[0].position}}</view>
            <view class="cc-stack">
              <template is="spreadCard" data="{{cell: drawn[0], revealedCount}}" />
              <!-- 2 号牌横压：容器整体旋转 90°，视觉探向左右邻格（经典摆法） -->
              <view class="cc-cross-over"><template is="spreadCard" data="{{cell: drawn[1], revealedCount}}" /></view>
            </view>
            <view class="pos mono cc-pos2">{{drawn[1].position}}</view>
          </view>
          <view class="cc-cell"><template is="spreadCell" data="{{cell: drawn[5], revealedCount}}" /></view>
          <view></view>
          <view class="cc-cell"><template is="spreadCell" data="{{cell: drawn[2], revealedCount}}" /></view>
          <view></view>
        </view>
        <view class="celtic-staff">
          <view class="cc-cell" wx:for="{{[9, 8, 7, 6]}}" wx:key="index">
            <template is="spreadCell" data="{{cell: drawn[item], revealedCount}}" />
          </view>
        </view>
      </view>

      <!-- 六芒星（7 牌）：▽ 时间三角（过去/现在/未来）+ △ 境遇三角（阻碍/助力/建议）+ 中心结果
           网格定位：过去 r1c1 / 未来 r1c3 / 现在 r2c2 / 结果 r3c2（中心金辉）/ 建议 r4c2 / 阻碍 r5c1 / 助力 r5c3 -->
      <view wx:elif="{{spread === 'hexagram'}}" class="hex-layout">
        <view class="hex-cell hx0"><template is="spreadCell" data="{{cell: drawn[0], revealedCount}}" /></view>
        <view class="hex-cell hx2"><template is="spreadCell" data="{{cell: drawn[2], revealedCount}}" /></view>
        <view class="hex-cell hx1"><template is="spreadCell" data="{{cell: drawn[1], revealedCount}}"/></view>
        <view class="hex-cell hx6"><template is="spreadCell" data="{{cell: drawn[6], revealedCount}}" /></view>
        <view class="hex-cell hx5"><template is="spreadCell" data="{{cell: drawn[5], revealedCount}}" /></view>
        <view class="hex-cell hx3"><template is="spreadCell" data="{{cell: drawn[3], revealedCount}}" /></view>
        <view class="hex-cell hx4"><template is="spreadCell" data="{{cell: drawn[4], revealedCount}}" /></view>
      </view>

      <!-- 逐牌解读 -->
      <view class="meaning-panels">
        <view wx:for="{{revealedCards}}" wx:key="index" class="m-panel">
          <view class="m-head">
            <text wx:if="{{item.position}}" class="m-pos mono">{{item.position}}</text>
            <text class="m-name">{{item.card.name}}</text>
            <text class="m-ori mono {{item.orientation}}">{{item.orientation === 'reversed' ? '逆位' : '正位'}}</text>
          </view>
          <!-- v3 契约：牌位释义一句话（6 个牌阵都有） -->
          <view wx:if="{{item.positionDesc}}" class="m-posdesc">{{item.positionDesc}}</view>
          <view class="kw-chips">
            <text wx:for="{{item.keywordsArr}}" wx:for-item="k" wx:key="index" class="kw-chip">{{k}}</text>
          </view>
          <view class="m-text">{{item.meaning}}</view>
        </view>
      </view>

      <view class="stage-actions">
        <button class="btn-gold" bindtap="resetDraw">重新抽牌</button>
      </view>
    </block>
  </view>

  <!-- ===== 牌库（懒加载） ===== -->
  <view class="glass-card archive">
    <view class="archive-head" bindtap="toggleArchive">
      <view class="sec-title">牌库 <text class="sec-title-en mono">ARCANA ARCHIVE</text></view>
      <text class="toggle mono">{{archiveOpen ? '收起 −' : '展开 +'}}</text>
    </view>
    <view wx:if="{{archiveOpen}}" class="archive-body">
      <view wx:if="{{cardsLoading}}" class="state-box"><view class="spinner"></view></view>
      <view wx:elif="{{cardsError}}" class="error-line">{{cardsError}}</view>
      <block wx:else>
        <view wx:for="{{groups}}" wx:key="key" class="group">
          <view class="group-title mono">{{item.zh}} · {{item.key}}</view>
          <view class="card-grid">
            <view
              wx:for="{{item.cards}}"
              wx:for-item="c"
              wx:key="id"
              class="grid-card"
              data-card="{{c}}"
              bindtap="onCardTap"
            >
              <tarot-card card="{{c}}" size="sm" />
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 牌详情弹层 -->
  <view wx:if="{{activeCard}}" class="modal-mask" bindtap="closeModal">
    <view class="modal glass-card" catchtap="noop">
      <view class="modal-close mono" catchtap="closeModal">✕</view>
      <view class="modal-face {{activeCard.imgSrc ? 'has-img' : ''}}">
        <!-- 有牌图（服务器托管 tarot-{no}.webp）：标题旁展示牌面
             （懒加载 + aspectFit + 圆角 + 微暗 + 淡金描边），逆位旋转 180°；加载失败回落纯样式牌面 -->
        <image wx:if="{{activeCard.imgSrc}}" class="m-card-img {{activeCard.orientation === 'reversed' ? 'reversed' : ''}}" src="{{activeCard.imgSrc}}" mode="aspectFit" lazy-load binderror="onCardImgError" />
        <!-- 无牌图的牌：保持纯样式牌面 -->
        <tarot-card wx:else card="{{activeCard}}" size="md" />
      </view>
      <view class="modal-info">
        <view class="m-title">
          <text class="zh">{{activeCard.name}}</text>
          <text class="en">{{activeCard.nameEn}}</text>
        </view>
        <view class="m-block">
          <view class="m-label mono jade">正位 UPRIGHT</view>
          <view class="kw-chips">
            <text wx:for="{{activeCard.uprightArr}}" wx:key="index" class="kw-chip">{{item}}</text>
          </view>
          <view class="m-text">{{activeCard.uprightMeaning}}</view>
        </view>
        <view class="m-block">
          <view class="m-label mono cinnabar">逆位 REVERSED</view>
          <view class="kw-chips">
            <text wx:for="{{activeCard.reversedArr}}" wx:key="index" class="kw-chip">{{item}}</text>
          </view>
          <view class="m-text">{{activeCard.reversedMeaning}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="footer mono">
    <view class="f-legal">星语 STARWHISPER · 仅供娱乐</view>
    <view class="f-wish"><text class="f-star">✦</text> 愿你被星辰温柔以待 <text class="f-star">✦</text></view>
  </view>
</view>

/* ===== 塔罗页样式 ===== */
.page {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx 64rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.wordmark {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 14rpx;
}
.wm-zh {
  font-family: var(--font-display);
  font-size: 56rpx;
  letter-spacing: 0.22em;
  color: var(--gold);
}
.wm-en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 32rpx;
  color: var(--ink-dim2);
}

/* ===== 每日塔罗 ===== */
.daily {
  display: flex;
  gap: 40rpx;
  padding: 40rpx 36rpx;
  transition: opacity 0.25s ease;
}
.daily.refreshing {
  opacity: 0.55;
}
.daily-face {
  flex: none;
  width: 260rpx;
}
.daily-panel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.daily-name .zh {
  font-family: var(--font-display);
  font-size: 52rpx;
  color: var(--gold);
  letter-spacing: 0.14em;
}
.daily-name .en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 30rpx;
  color: var(--ink-dim2);
  margin-left: 16rpx;
}
.meaning {
  font-size: 30rpx;
  line-height: 2;
  color: rgba(232, 230, 240, 0.9);
}
.kw-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

/* ===== 通用小节标题 ===== */
.sec-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  letter-spacing: 0.24em;
  color: var(--ink);
}
.sec-title-en {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  margin-left: 16rpx;
}

/* ===== 抽牌仪式 ===== */
.ritual {
  margin-top: 36rpx;
  padding: 36rpx;
}
.mode-row {
  display: flex;
  gap: 20rpx;
  margin: 28rpx 0 32rpx;
  flex-wrap: wrap;
}
.mode-btn {
  font-size: 26rpx;
  letter-spacing: 0.16em;
  padding: 14rpx 28rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(139, 135, 176, 0.25);
  color: var(--ink-dim2);
}
.mode-btn.active {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(232, 196, 124, 0.08);
}
.mode-btn.disabled {
  opacity: 0.5;
}

/* 牌背排 */
.backs-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 16rpx 0 32rpx;
}
.back-item {
  width: 150rpx;
  flex: none;
}

.stage-actions {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

/* 3D 翻牌 */
.drawn-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 12rpx 0 32rpx;
}
.drawn-item {
  width: 180rpx;
  flex: none;
}
.pos {
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  margin-bottom: 12rpx;
}
.flip {
  perspective: 1200rpx;
}
.flip-inner {
  position: relative;
  width: 100%;
  aspect-ratio: 7 / 12;
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
}
.flip.flipped .flip-inner {
  transform: rotateY(180deg);
}
.flip-back,
.flip-front {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  backface-visibility: hidden;
}
.flip-front {
  transform: rotateY(180deg);
}

/* ===== 二选一：现状居中略小 + 两翼 + 分叉线 ===== */
.choice-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 32rpx;
}
.choice-top {
  width: 150rpx; /* 现状牌略小 */
}
.fork {
  position: relative;
  width: 420rpx;
  height: 56rpx;
}
/* 分叉线：从现状牌底向两翼张开的两根细线 */
.fork-line {
  position: absolute;
  left: 50%;
  top: 0;
  width: 1px;
  height: 72rpx;
  background: rgba(232, 196, 124, 0.35);
  transform-origin: 0 0;
}
.fork-line.left {
  transform: rotate(52deg);
}
.fork-line.right {
  transform: rotate(-52deg);
}
.choice-wings {
  display: flex;
  justify-content: space-between;
  width: 560rpx;
}
.choice-wings .drawn-item {
  width: 180rpx;
  flex: none;
}

/* ===== 爱情十字：五宫格 ===== */
.love-grid {
  display: grid;
  grid-template-columns: repeat(3, 196rpx);
  justify-content: center;
  gap: 18rpx;
  padding: 12rpx 0 32rpx;
}
.love-cell {
  width: 196rpx;
}
/* 五宫格定位：c0=上（现实阻碍） c1=左（你的状态） c2=中（关系现状） c3=右（对方的状态） c4=下（结果与建议） */
.love-cell.c0 { grid-row: 1; grid-column: 2; }
.love-cell.c1 { grid-row: 2; grid-column: 1; }
.love-cell.c2 { grid-row: 2; grid-column: 2; }
.love-cell.c3 { grid-row: 2; grid-column: 3; }
.love-cell.c4 { grid-row: 3; grid-column: 2; }

/* 逐牌解读 */
.meaning-panels {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.m-panel {
  border: 1px solid rgba(139, 135, 176, 0.16);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.m-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.m-pos {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
}
.m-name {
  font-family: var(--font-display);
  font-size: 34rpx;
  letter-spacing: 0.12em;
  color: var(--ink);
}
.m-ori {
  font-size: 24rpx;
  letter-spacing: 0.16em;
  margin-left: auto;
}
.m-ori.upright { color: var(--jade); }
.m-ori.reversed { color: var(--cinnabar); }
.m-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: rgba(232, 230, 240, 0.9);
}

/* ===== 牌库 ===== */
.archive {
  margin-top: 36rpx;
}
.archive-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
}
.toggle {
  font-size: 25rpx;
  letter-spacing: 0.2em;
  color: var(--gold);
}
.archive-body {
  padding: 0 36rpx 36rpx;
}
.group {
  margin-top: 28rpx;
}
.group-title {
  font-size: 25rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
  border-bottom: 1px solid rgba(139, 135, 176, 0.16);
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

/* ===== 详情弹层 ===== */
.modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 40;
  background: rgba(7, 11, 30, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal {
  position: relative;
  display: flex;
  gap: 32rpx;
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 36rpx;
  overflow-y: auto;
  box-sizing: border-box;
}
.modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  color: var(--ink-dim2);
  font-size: 32rpx;
  padding: 8rpx 16rpx;
  z-index: 2;
}
.modal-face {
  flex: none;
  width: 200rpx;
}
.modal-info {
  flex: 1;
  min-width: 0;
}
.m-title .zh {
  font-family: var(--font-display);
  font-size: 44rpx;
  color: var(--gold);
  letter-spacing: 0.12em;
}
.m-title .en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 28rpx;
  color: var(--ink-dim2);
  margin-left: 16rpx;
}
.m-block {
  margin-top: 28rpx;
}
.m-label {
  font-size: 25rpx;
  letter-spacing: 0.2em;
  margin-bottom: 14rpx;
}
.m-label.jade { color: var(--jade); }
.m-label.cinnabar { color: var(--cinnabar); }

/* 页脚 */
.footer {
  margin-top: auto;
  padding-top: 72rpx;
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}

<!-- 我的页 -->
<view class="page">
  <star-layer />

  <view class="eyebrow">ACCOUNT · 我的</view>
  <view class="wordmark">
    <text class="wm-zh">观星人</text>
    <text class="wm-en">Profile</text>
  </view>
  <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>

  <!-- ===== 打卡卡（顶部） ===== -->
  <view class="glass-card checkin-card">
    <view class="ci-head">
      <text class="ci-title">每日打卡</text>
      <text class="ci-title-en mono">CHECK-IN</text>
    </view>
    <!-- 未登录：引导复用登录 -->
    <view wx:if="{{!token}}" class="ci-anon">
      <view class="ci-anon-text">登录后开启打卡，记录每一天的星辰</view>
    </view>
    <!-- 已登录 -->
    <block wx:elif="{{checkinStatus}}">
      <view class="ci-stats">
        <text class="ci-streak">连续 {{checkinStatus.streak}} 天</text>
        <text class="ci-sep">✦</text>
        <text class="ci-total">共 {{checkinStatus.totalDays}} 天</text>
      </view>
      <!-- 最近 14 天 mini 点阵（打过的金色点） -->
      <view class="ci-dots">
        <view
          wx:for="{{checkinDots}}"
          wx:key="date"
          class="ci-dot {{item.done ? 'done' : ''}}"
        ></view>
      </view>
      <button size="mini"
        class="btn-gold ci-btn {{checkinStatus.todayDone || checking ? 'disabled done' : ''}}"
        bindtap="doCheckin"
        disabled="{{checkinStatus.todayDone || checking}}"
      >{{checkinStatus.todayDone ? '今日已打卡' : (checking ? '打卡中…' : '今日打卡')}}</button>
    </block>
    <!-- 加载失败：错误文案 + 重试（不再无限 spinner） -->
    <view wx:elif="{{checkinError}}" class="ci-anon">
      <view class="ci-anon-text">{{checkinError}}</view>
      <button size="mini" class="btn-ghost ci-retry" bindtap="loadCheckinStatus">重新加载</button>
    </view>
    <view wx:else class="ci-anon"><view class="spinner"></view></view>
  </view>

  <!-- ===== 每日运势订阅提醒 ===== -->
  <view class="glass-card notify-card">
    <view class="ci-head">
      <text class="ci-title">每日运势提醒</text>
      <text class="ci-title-en mono">DAILY FORTUNE</text>
    </view>
    <view class="nt-row {{notifyEntry.clickable && !notifyBusy ? '' : 'nt-disabled'}}" bindtap="onNotifyTap">
      <text class="nt-status {{notifySubscribed ? 'nt-on' : ''}}">{{notifyEntry.text}}</text>
      <text wx:if="{{notifyEntry.clickable}}" class="nt-arrow">{{notifySubscribed ? '点击取消' : '›'}}</text>
    </view>
    <view class="nt-tip">{{notifyTip}}</view>
  </view>

  <!-- ===== 每周运势订阅提醒（每周一 8:05 推送；模板未配置时显示「即将上线」） ===== -->
  <view class="glass-card notify-card">
    <view class="ci-head">
      <text class="ci-title">每周运势提醒</text>
      <text class="ci-title-en mono">WEEKLY FORTUNE</text>
    </view>
    <view class="nt-row {{weeklyEntry.clickable && !weeklyBusy ? '' : 'nt-disabled'}}" bindtap="onWeeklyNotifyTap">
      <text class="nt-status {{weeklySubscribed ? 'nt-on' : ''}}">{{weeklyEntry.text}}</text>
      <text wx:if="{{weeklyEntry.clickable}}" class="nt-arrow">{{weeklySubscribed ? '点击取消' : '›'}}</text>
    </view>
    <view class="nt-tip">{{weeklyTip}}</view>
  </view>

  <!-- ===== 连续打卡 + 勋章墙（汇总接口失败时整块隐藏） ===== -->
  <view wx:if="{{token && checkinSummary}}" class="glass-card streak-card">
    <!-- 连续打卡横幅 -->
    <view class="streak-banner">
      <text class="streak-flame">🔥</text>
      <view class="streak-main">
        <view class="streak-num">
          <text class="n">{{checkinSummary.currentStreak}}</text>
          <text class="unit">天连续打卡</text>
        </view>
        <view class="streak-sub mono">最长纪录 {{checkinSummary.maxStreak}} 天 · 累计 {{checkinSummary.totalDays}} 天</view>
      </view>
      <view wx:if="{{checkinSummary.todayChecked}}" class="streak-today mono">今日已打卡 ✓</view>
    </view>
    <!-- 勋章墙 -->
    <block wx:if="{{badges.length}}">
      <view class="divider"><view class="d-line"></view><text>✦</text><view class="d-line"></view></view>
      <view class="badge-wall">
        <view wx:for="{{badges}}" wx:key="code" class="badge {{item.unlocked ? 'unlocked' : ''}}">
          <view class="badge-star">{{item.unlocked ? '★' : '☆'}}</view>
          <view class="badge-name">{{item.name}}</view>
          <view class="badge-desc">{{item.unlocked ? item.desc : (item.progressText + ' · ' + item.desc)}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- ===== 未登录 ===== -->
  <view wx:if="{{!token}}" class="glass-card login-card">
    <view class="avatar-placeholder">✦</view>
    <view class="login-tip">登录后可同步保存塔罗抽牌与配对比对记录</view>
    <button size="mini" class="btn-gold login-btn {{logging ? 'disabled' : ''}}" bindtap="onWechatLogin">
      {{logging ? '登录中…' : '微信登录'}}
    </button>
    <view wx:if="{{loginError}}" class="error-line">{{loginError}}</view>
  </view>

  <!-- ===== 已登录 ===== -->
  <block wx:else>
    <view class="glass-card user-card">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder sm">✦</view>
      <view class="user-info">
        <view class="user-name">{{userInfo.nickname || '星友'}}</view>
        <view class="user-id mono">ID · {{userInfo.id}}</view>
      </view>
      <view class="profile-edit mono" bindtap="toggleNameEdit">{{nameEditing ? '取消' : '改名'}}</view>
      <view class="logout mono" bindtap="onLogout">退出</view>
    </view>
    <!-- 改名：input type="nickname" 聚焦时微信会自动带出用户微信昵称供一键填入 -->
    <view wx:if="{{nameEditing}}" class="glass-card name-edit-card">
      <input class="name-input" type="nickname" value="{{nameInput}}" maxlength="20" placeholder="点这里，可用微信昵称一键填入" bindinput="onNameInput" />
      <view wx:if="{{nameError}}" class="error-line">{{nameError}}</view>
      <button size="mini" class="btn-gold {{nameSaving ? 'disabled' : ''}}" bindtap="saveNickname">{{nameSaving ? '保存中…' : '保存昵称'}}</button>
      <view class="name-hint">昵称全站唯一，撞名会提示换一个</view>
    </view>

    <!-- 我的记录 -->
    <view class="glass-card history-card">
      <view class="sec-title">我的记录 <text class="sec-title-en mono">HISTORY</text></view>

      <!-- 加载失败：错误态 + 重试（不能吞成「暂无记录」骗用户说没数据） -->
      <view wx:if="{{historyError}}" class="empty-line history-error">
        <text class="history-error-text">{{historyError}}</text>
        <button size="mini" class="btn-ghost" bindtap="retryHistory">重新加载</button>
      </view>

      <view class="history-group">
        <view class="group-label mono">塔罗 TAROT</view>
        <view wx:if="{{!historyTarot.length}}" class="empty-line">
          {{historyError ? '读取失败' : (historyLoaded ? '暂无记录，去抽一张牌吧' : '读取中…')}}
        </view>
        <view
          wx:for="{{historyTarot}}"
          wx:key="id"
          class="record {{expandedId === item.id ? 'open' : ''}}"
          data-id="{{item.id}}"
          bindtap="onRecordTap"
        >
          <view class="record-head">
            <text class="record-title">{{item.title}}</text>
            <text class="record-time mono">{{item.timeText}}</text>
          </view>
          <view wx:if="{{expandedId === item.id}}" class="record-detail">
            <view
              wx:for="{{item.detailLines}}"
              wx:for-item="line"
              wx:key="index"
              class="rd-line {{line.cont ? 'rd-cont' : ''}}"
            >
              <text wx:if="{{line.label}}" class="rd-label">{{line.label}}</text>
              <text class="rd-text">{{line.text}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="history-group">
        <view class="group-label mono">配对 MATCH</view>
        <view wx:if="{{!historyMatch.length}}" class="empty-line">
          {{historyError ? '读取失败' : (historyLoaded ? '暂无记录，去配个对吧' : '读取中…')}}
        </view>
        <view
          wx:for="{{historyMatch}}"
          wx:key="id"
          class="record {{expandedId === item.id ? 'open' : ''}}"
          data-id="{{item.id}}"
          bindtap="onRecordTap"
        >
          <view class="record-head">
            <text class="record-title">{{item.title}}</text>
            <text class="record-time mono">{{item.timeText}}</text>
          </view>
          <view wx:if="{{expandedId === item.id}}" class="record-detail">
            <view
              wx:for="{{item.detailLines}}"
              wx:for-item="line"
              wx:key="index"
              class="rd-line {{line.cont ? 'rd-cont' : ''}}"
            >
              <text wx:if="{{line.label}}" class="rd-label">{{line.label}}</text>
              <text class="rd-text">{{line.text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 帮助与反馈（游客也能用：这是目前唯一的真实触达通道） ===== -->
  <view class="glass-card feedback-card">
    <view class="sec-title">帮助与反馈 <text class="sec-title-en mono">FEEDBACK</text></view>

    <!-- 我的星座：登录后跟账号走；游客只存本机 -->
    <view wx:if="{{mySignName}}" class="my-sign-row">
      <text class="ms-label mono">MY SIGN</text>
      <text class="ms-value">{{mySignName}}</text>
    </view>

    <view class="fb-hint">{{token ? '遇到问题、或者有想要的星座内容，都可以直接告诉我。' : '不用登录也能留言。想让我记住你的星座，登录就行。'}}</view>
    <textarea
      class="fb-input"
      value="{{fbContent}}"
      maxlength="500"
      placeholder="比如：我想看每日塔罗日签 / 某个页面点不动了"
      bindinput="onFbInput"
      disabled="{{fbSending}}"
    />
    <view wx:if="{{fbError}}" class="error-line">{{fbError}}</view>
    <view wx:if="{{fbDone}}" class="fb-done">收到了，谢谢你说这些 ✦</view>
    <view class="fb-actions">
      <button size="mini" class="btn-gold {{fbSending || !fbContent ? 'disabled' : ''}}" disabled="{{fbSending || !fbContent}}" bindtap="submitFeedback">
        {{fbSending ? '发送中…' : '发送反馈'}}
      </button>
      <button size="mini" class="btn-ghost" open-type="contact">联系客服</button>
    </view>
  </view>

  <view class="footer mono">
    <view class="f-legal">星语 STARWHISPER · 仅供娱乐</view>
    <view class="f-wish"><text class="f-star">✦</text> 愿你被星辰温柔以待 <text class="f-star">✦</text></view>
    <view class="f-version">v{{version}}</view>
  </view>

  <!-- 星座选择底部弹层（订阅时选择推送星座；ActionSheet 限 6 项放不下 12 星座） -->
  <view wx:if="{{signPickerOpen}}" class="sign-mask" bindtap="onSignPickerCancel">
    <view class="sign-sheet" catchtap="noop">
      <view class="sign-title">选择你的星座</view>
      <view class="sign-grid">
        <button wx:for="{{signOptions}}" wx:key="nameEn" size="mini" class="sign-cell" data-index="{{index}}" bindtap="onSignPick">{{item.name}}</button>
      </view>
      <view class="sign-cancel" bindtap="onSignPickerCancel">取消</view>
    </view>
  </view>
</view>

/* ===== 我的页样式 ===== */
.page {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx 64rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.wordmark {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 14rpx;
}
.wm-zh {
  font-family: var(--font-display);
  font-size: 56rpx;
  letter-spacing: 0.22em;
  color: var(--gold);
}
.wm-en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 32rpx;
  color: var(--ink-dim2);
}

/* ===== 打卡卡 ===== */
.checkin-card {
  margin-top: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.ci-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.ci-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  letter-spacing: 0.24em;
  color: var(--ink);
}
.ci-title-en {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
}
.ci-anon {
  padding: 16rpx 0;
}
.ci-anon-text {
  font-size: 28rpx;
  letter-spacing: 0.1em;
  color: var(--ink-dim2);
  line-height: 1.8;
}
.ci-stats {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  white-space: nowrap; /* 「连续 X 天 ✦ 共 Y 天」内部空格处不折断 */
}
.ci-streak {
  font-family: var(--font-display);
  font-size: 36rpx;
  color: var(--gold);
  letter-spacing: 0.08em;
}
.ci-sep {
  color: var(--gold-dim);
  font-size: 24rpx;
}
.ci-total {
  font-size: 28rpx;
  color: var(--ink-dim2);
}
/* 最近 14 天点阵 */
.ci-dots {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.ci-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(139, 135, 176, 0.18);
}
.ci-dot.done {
  background: var(--gold);
  box-shadow: 0 0 10rpx rgba(232, 196, 124, 0.45);
}
.ci-btn {
  align-self: flex-start;
}
.ci-btn.done {
  border-color: rgba(139, 135, 176, 0.3);
  background: rgba(139, 135, 176, 0.08);
  color: var(--ink-dim2);
}

/* ===== 每日运势订阅提醒 ===== */
.notify-card {
  margin-top: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.nt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(232, 196, 124, 0.25);
  border-radius: 16rpx;
  background: rgba(232, 196, 124, 0.05);
}
.nt-row:active {
  opacity: 0.7;
}
.nt-disabled {
  opacity: 0.5;
}
.nt-status {
  font-size: 28rpx;
  letter-spacing: 0.08em;
  color: var(--ink);
}
.nt-status.nt-on {
  color: var(--gold);
}
.nt-arrow {
  font-size: 24rpx;
  color: var(--ink-dim2);
  letter-spacing: 0.06em;
}
.nt-tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-dim2);
  letter-spacing: 0.04em;
}

/* ===== 登录卡片 =====
   游客进「我的」页看到的就是这一张，所以它是整页唯一的说服位置：
   一句承诺 + 三条具体收益 + 一个动作。克制、不堆装饰。 */
.login-card {
  margin-top: 28rpx;
  padding: 56rpx 44rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}
/* 星标记：用径向渐变做一圈极淡的金晕，替代原来那个空头像圆 */
.lc-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 1px solid var(--gold-hairline);
  background: radial-gradient(circle at 50% 40%, rgba(232, 196, 124, 0.16), rgba(232, 196, 124, 0.02) 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--gold);
  margin-bottom: 28rpx;
}
.lc-title {
  font-size: 34rpx;
  letter-spacing: 0.06em;
  color: var(--ink);
  text-align: center;
  margin-bottom: 30rpx;
}
.lc-list {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 40rpx;
  padding: 0 24rpx;
}
.lc-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.lc-dot {
  flex: none;
  color: var(--gold-dim);
  font-size: 26rpx;
  line-height: 1.7;
}
.lc-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-dim2);
  letter-spacing: 0.02em;
}
.lc-note {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: var(--ink-dim);
  letter-spacing: 0.04em;
}
.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 1px solid var(--gold-hairline);
  background: rgba(35, 32, 72, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--gold);
}
.avatar-placeholder.sm {
  width: 96rpx;
  height: 96rpx;
  font-size: 36rpx;
  flex: none;
}
.login-btn {
  width: 100%;
  max-width: 480rpx;
}
.page .btn-ghost {
  background: none;
  border: 1px solid rgba(139, 135, 176, 0.25);
  color: var(--ink-dim2);
  font-size: 26rpx;
  letter-spacing: 0.18em;
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
  max-width: 100%;
  height: auto;
  box-sizing: border-box;
  font-weight: 400;
  line-height: 1.6;
  white-space: normal;
  overflow-wrap: anywhere;
}
.btn-ghost::after, .btn-gold::after {
  border: none; /* 去掉 button 默认边框 */
}

/* ===== 用户卡片 ===== */
.user-card {
  margin-top: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 1px solid var(--gold-hairline);
  flex: none;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-family: var(--font-display);
  font-size: 36rpx;
  letter-spacing: 0.12em;
  color: var(--ink);
}
.user-id {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-dim2);
}
.logout {
  font-size: 26rpx;
  letter-spacing: 0.2em;
  color: var(--cinnabar);
  padding: 10rpx 20rpx;
}

/* ===== 历史记录 ===== */
.history-card {
  margin-top: 28rpx;
  padding: 32rpx;
}
.sec-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  letter-spacing: 0.24em;
  color: var(--ink);
  margin-bottom: 20rpx;
}
.sec-title-en {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  margin-left: 16rpx;
  white-space: nowrap; /* 英文短语不在空格/连字符处断成两截 */
}
.history-group {
  margin-top: 20rpx;
}
.group-label {
  font-size: 25rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1px solid rgba(139, 135, 176, 0.16);
}
.empty-line {
  font-size: 26rpx;
  color: var(--ink-dim2);
  padding: 20rpx 0;
  letter-spacing: 0.1em;
}
/* 历史记录加载失败：错误文案 + 重试按钮同一行（失败不再伪装成「暂无记录」） */
.history-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--cinnabar);
}
.history-error-text {
  flex: 1;
  min-width: 0;
  color: var(--cinnabar);
}
.record {
  padding: 16rpx 8rpx;
  border-bottom: 1px solid rgba(139, 135, 176, 0.1);
}
.record-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.record-title {
  flex: 1;
  min-width: 0; /* flex 子项允许收缩，省略号才生效 */
  font-size: 28rpx;
  color: var(--ink);
  white-space: nowrap; /* 标题一律单行，超出省略号 */
  overflow: hidden;
  text-overflow: ellipsis;
}
.record-time {
  flex: none;
  white-space: nowrap; /* 「06.03 14:22」日期与时间不在空格处折断 */
  font-size: 24rpx;
  color: var(--ink-dim2);
}
.record-detail {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-left: 4rpx solid var(--gold-hairline);
}
/* 结构化详情行：标签（金色次级） + 正文；cont 行为上一行的延续，缩进对齐 */
.rd-line {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
}
.rd-line.rd-cont {
  padding-left: 112rpx; /* 标签 96rpx + 间距 16rpx */
}
.rd-label {
  flex: none;
  min-width: 96rpx;
  font-size: 24rpx;
  letter-spacing: 0.1em;
  color: var(--gold-dim);
  line-height: 1.9;
}
.rd-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.9;
  color: rgba(232, 230, 240, 0.9);
}

/* 页脚 */
.footer {
  margin-top: auto;
  padding-top: 72rpx;
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}
/* 寄语行：视觉收尾，展示字体 + 香槟金 + ✦ 点缀 */
.f-wish {
  margin-top: 12rpx;
  font-family: var(--font-display);
  font-size: 26rpx;
  letter-spacing: 0.3em;
  color: var(--gold);
}
.f-wish .f-star {
  font-size: 20rpx;
  color: rgba(232, 196, 124, 0.55);
}
/* 版本号：低调收尾，比页脚正文更小更淡 */
.f-version {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--ink-dim2);
  opacity: 0.6;
}

/* ===== 连续打卡横幅 + 勋章墙 ===== */
.streak-card {
  margin-top: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.streak-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.streak-flame {
  font-size: 64rpx;
  flex: none;
}
.streak-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.streak-num {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.streak-num .n {
  font-family: var(--font-display);
  font-size: 64rpx;
  line-height: 1;
  color: var(--gold);
}
.streak-num .unit {
  font-size: 28rpx;
  letter-spacing: 0.12em;
  color: var(--ink);
}
.streak-sub {
  font-size: 23rpx;
  letter-spacing: 0.14em;
  color: var(--ink-dim2);
}
.streak-today {
  flex: none;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--jade);
  border: 1px solid rgba(127, 191, 158, 0.35);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.badge-wall {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
  border: 1px solid rgba(139, 135, 176, 0.18);
  border-radius: 12rpx;
  background: rgba(139, 135, 176, 0.05);
  text-align: center;
}
.badge-star {
  font-size: 44rpx;
  color: rgba(139, 135, 176, 0.45);
}
.badge-name {
  font-size: 26rpx;
  letter-spacing: 0.1em;
  color: var(--ink-dim2);
}
.badge-desc {
  font-size: 20rpx;
  line-height: 1.6;
  color: rgba(169, 164, 204, 0.6);
}
/* 已解锁：金色点亮 */
.badge.unlocked {
  border-color: var(--gold-hairline);
  background: rgba(232, 196, 124, 0.07);
}
.badge.unlocked .badge-star {
  color: var(--gold);
}
.badge.unlocked .badge-name {
  color: var(--gold);
}
.badge.unlocked .badge-desc {
  color: var(--ink-dim2);
}

/* 打卡状态加载失败的重试按钮 */
.ci-retry {
  margin-top: 16rpx;
  align-self: flex-start;
}

/* ===== 星座选择底部弹层（订阅推送用） ===== */
.sign-mask {
  position: fixed; inset: 0; z-index: 99;
  background: rgba(10, 8, 24, 0.72);
  display: flex; align-items: flex-end;
}
.sign-sheet {
  width: 100%; box-sizing: border-box;
  background: #1E1B36;
  border-top: 1rpx solid var(--gold-hairline);
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sign-title {
  text-align: center; font-size: 30rpx; letter-spacing: 0.2em;
  color: var(--gold); margin-bottom: 28rpx;
}
.sign-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.sign-cell {
  margin: 0; padding: 18rpx 0; font-size: 26rpx; line-height: 1.4;
  color: var(--ink); background: rgba(232, 196, 124, 0.06);
  border: 1rpx solid var(--gold-hairline); border-radius: 12rpx;
}
.sign-cell::after { border: 0; }
.sign-cancel {
  margin-top: 24rpx; padding: 18rpx 0; text-align: center;
  font-size: 26rpx; color: var(--ink-dim);
  border-top: 1rpx solid rgba(139, 135, 176, 0.12);
}

/* ===== 改名（昵称编辑） ===== */
.profile-edit {
  font-size: 24rpx;
  color: var(--ink-dim);
  padding: 8rpx 4rpx;
  margin-right: 16rpx;
}
.name-edit-card {
  margin-top: 0;
  border-top: 0;
  border-radius: 0 0 12rpx 12rpx;
  padding: 24rpx 32rpx 28rpx;
}
.name-input {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--gold-hairline);
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.15);
  color: var(--ink);
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.name-edit-card .btn-gold {
  width: 100%;
  font-size: 26rpx;
}
.name-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-dim2);
  text-align: center;
}

/* ===== 帮助与反馈卡 ===== */
.feedback-card {
  margin: 20rpx 0 0;
}
.my-sign-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 4rpx;
}
.ms-label {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--gold-dim);
}
.ms-value {
  font-size: 26rpx;
  color: var(--gold);
  letter-spacing: 0.04em;
}
.fb-hint {
  margin: 10rpx 0 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-dim2);
}
.fb-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--gold-hairline);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.6;
}
.fb-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.fb-done {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--gold);
}

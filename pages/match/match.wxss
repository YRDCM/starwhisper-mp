/* ===== 配对页样式 ===== */
.page {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx 64rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.wordmark {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 14rpx;
}
.wm-zh {
  font-family: var(--font-display);
  font-size: 56rpx;
  letter-spacing: 0.22em;
  color: var(--gold);
}
.wm-en {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 32rpx;
  color: var(--ink-dim2);
}

/* ===== 选择器 ===== */
.picker-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.picker-label {
  font-size: 25rpx;
  letter-spacing: 0.24em;
  color: var(--ink-dim2);
}
.gender-row {
  display: flex;
  gap: 12rpx;
}
.gender-chip {
  font-size: 24rpx;
  letter-spacing: 0.1em;
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
  border: 1px solid rgba(139, 135, 176, 0.25);
  color: var(--ink-dim2);
}
.gender-chip.active {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(232, 196, 124, 0.08);
}
.sign-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.sign-chip {
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  padding: 14rpx 0;
  border-radius: 8rpx;
  border: 1px solid rgba(139, 135, 176, 0.2);
  color: var(--ink);
  background: rgba(35, 32, 72, 0.4);
}
.sign-chip.active {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(232, 196, 124, 0.10);
}
.match-action {
  display: flex;
  justify-content: center;
}

/* ===== 综合指数金环 ===== */
.overall-card {
  margin-top: 36rpx;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.pair-names {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.p-name {
  font-family: var(--font-display);
  font-size: 44rpx;
  letter-spacing: 0.12em;
  color: var(--ink);
}
.pair-x {
  color: var(--gold-dim);
  font-size: 26rpx;
}
.pair-meta {
  font-size: 25rpx;
  letter-spacing: 0.16em;
  color: var(--ink-dim2);
}
.ring-wrap {
  padding: 16rpx 0;
}
/* 金环：conic-gradient 填充 + 内圆遮盖成环（WXSS 支持 conic-gradient） */
.ring {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-hole {
  width: 236rpx;
  height: 236rpx;
  border-radius: 50%;
  background: #10163A;
  border: 1px solid var(--gold-hairline);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.ring-num {
  font-family: var(--font-display);
  font-size: 84rpx;
  color: var(--gold);
}
.ring-unit {
  font-size: 24rpx;
  letter-spacing: 0.24em;
  color: var(--ink-dim2);
}

/* ===== 细分指数 ===== */
.sub-card {
  margin-top: 36rpx;
  padding: 36rpx;
}
.sec-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  letter-spacing: 0.24em;
  color: var(--ink);
  margin-bottom: 24rpx;
}
.sec-title-en {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--ink-dim2);
  margin-left: 16rpx;
}
.sub-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
}
.sub-row:last-child {
  margin-bottom: 0;
}
.sub-label {
  flex: none;
  width: 140rpx;
  font-size: 28rpx;
  letter-spacing: 0.12em;
  color: var(--ink);
}
.sub-bar {
  flex: 1;
  height: 6rpx;
  background: rgba(139, 135, 176, 0.15);
  border-radius: 3rpx;
  overflow: hidden;
}
.sub-bar-fill {
  display: block;
  height: 100%;
  background: var(--gold);
  border-radius: 3rpx;
  transition: width 0.5s ease;
}
.sub-val {
  flex: none;
  width: 64rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--gold);
}

/* ===== 文案分块 ===== */
.text-card {
  margin-top: 36rpx;
  padding: 36rpx;
}
.m-section {
  margin-bottom: 32rpx;
}
.m-label {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.m-zh {
  font-size: 30rpx;
  letter-spacing: 0.18em;
  color: var(--gold);
}
.m-en {
  font-size: 25rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}
.m-text {
  font-size: 30rpx;
  line-height: 2;
  color: rgba(232, 230, 240, 0.9);
}
.mc-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}
.source-tag {
  font-size: 25rpx;
  letter-spacing: 0.16em;
  color: var(--ink-dim2);
}
.source-tag.showapi {
  color: var(--gold);
}

/* 页脚 */
.footer {
  margin-top: auto;
  padding-top: 72rpx;
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 0.18em;
  color: var(--ink-dim2);
}
